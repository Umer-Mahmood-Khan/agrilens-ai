# Copy this file to .env and enter your key locally. Never commit .env.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
PORT=3001

# Optional: set AI_PROVIDER=gemini to use Google Gemini.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Deployment (optional). Defaults keep the app local-only.
# HOST=0.0.0.0                      # listen on all interfaces (set in the Docker image)
# ALLOWED_HOSTS=agrilens.example.com # public hostnames, comma-separated
# LIVE_ANALYSIS=visitor              # public demo: visitors enter their own API keys; keys here are ignored
#                                    # off = sample only; server (default) = use the key above, for local use
# MAX_CONCURRENT=3

# LIVE_LIMIT_PER_HOUR=10             # new live analyses per visitor per hour (0 = unlimited)
# TRUST_PROXY=1                      # proxies in front of the app, to read the visitor IP
